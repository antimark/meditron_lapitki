APP_SECRET_KEY=replace-with-a-long-random-secret
REGISTRATION_SECRET_KEY=replace-with-registration-secret
SESSION_COOKIE_SECURE=0
MAX_UPLOAD_MB=64
CARDIO_PIPELINE_CONFIG=/app/config/docker.toml

# Optional OpenAI-compatible API used by config/docker.toml.
LLM_API_BASE_URL=
LLM_API_MODEL=
LLM_API_KEY=

# Optional local OpenAI-compatible model service.
LOCAL_LLM_BASE_URL=http://host.docker.internal:8000/v1
LOCAL_LLM_API_KEY=EMPTY

# Anonymizer. clinical preserves ordinary clinical dates but removes direct identifiers.
ANONYMIZER_MODE=clinical
ANONYMIZER_USE_NER=0

# Docker build/runtime feature toggles.
INSTALL_LOCAL=1
LOCAL_LLM_ENABLED=1
LLM_API_ENABLED=1

# Optional keys for config/api_profiles/provider_2.toml and provider_3.toml
PROVIDER_2_API_KEY=
PROVIDER_3_API_KEY=
